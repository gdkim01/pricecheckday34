# 이 파일은 예시입니다. 값은 비어 있습니다. 내 PC에서 .env 라는 이름으로 복사해 값을 채웁니다.
# .env 는 .gitignore 에 들어 있어 GitHub에 올라가지 않습니다. 채팅·화면 코드에도 붙여넣지 않습니다.

# 강사에게 개인 메시지로 받은 Claude 키 (sk-ant- 로 시작)
ANTHROPIC_API_KEY=

# Supabase 주소와 Publishable key (config.js에 있는 두 값과 같습니다. sb_publishable_ 로 시작)
# sb_secret_ 으로 시작하는 Secret key는 여기에 넣지 않습니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 시험용 모의 실패 (Day34 6-3과 Day37에서만 씁니다. 평소에는 비워 둡니다. 배포 환경 변수에는 넣지 않습니다)
# 값: unavailable / transient_once / rate_limit_once / timeout / notfound / auth / permission / bad_request / quota / bad_output
AI_MOCK_FAIL=
